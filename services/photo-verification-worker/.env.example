# Server-side only. Never expose these values to Expo/Netlify public environment variables.
FACE_WORKER_HMAC_SECRET=replace-in-host-secret-store

# Exact host(s) from Supabase signed Storage URLs, comma separated.
# Production Chon.Love project currently uses the project host below.
FACE_ALLOWED_IMAGE_HOSTS=asnydvqsduonyidjyyzq.supabase.co

# Provisional SFace reference policy. Calibrate before tightening/loosening production auto-approval.
FACE_COSINE_THRESHOLD=0.363
FACE_MIN_STRONG_MATCHES=2

FACE_MAX_IMAGE_BYTES=10485760
FACE_REQUEST_SKEW_SECONDS=300

# Leave false in production. HTTP is allowed only for local CI smoke tests.
FACE_ALLOW_HTTP_FOR_TESTS=false

YUNET_MODEL_PATH=/models/yunet_int8bq.onnx
SFACE_MODEL_PATH=/models/sface_int8.onnx
PORT=8080
