{
  "name": "myfan",
  "version": "0.1.0",
  "private": true,
  "description": "Chon.Love Web V1 monorepo — nền tảng hẹn hò web-first cho thị trường Việt Nam.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build:netlify": "node ./scripts/build-netlify-mobile.mjs",
    "build:netlify:chon": "node ./scripts/build-netlify-chon.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "validate:workspace": "node ./scripts/validate-workspace.mjs",
    "validate:env": "node ./scripts/validate-env-contracts.mjs",
    "validate:database": "node ./scripts/verify-main-migration-lineage.mjs && node ./scripts/run-sql-tests.mjs",
    "validate:migration-lineage": "node ./scripts/verify-main-migration-lineage.mjs",
    "validate:lx15-regression": "node ./scripts/verify-lx15-regression.mjs",
    "validate:creator-e2e": "node ./scripts/verify-creator-activity-e2e.mjs",
    "validate:browser-e2e": "node ./scripts/verify-browser-e2e.mjs",
    "validate:br09": "node ./scripts/verify-br09-gate.mjs",
    "validate:br10": "node ./scripts/verify-br10-gate.mjs",
    "validate:web-r03-branding": "node ./scripts/validate-web-r03-branding.mjs",
    "check:generated": "node ./scripts/check-generated-supabase.mjs",
    "db:types": "node ./scripts/generate-supabase-types.mjs",
    "ci": "pnpm validate:workspace && pnpm validate:env && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20 <21",
    "pnpm": "9.15.4"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "5.6.3"
  }
}
